PORT=8080
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/realtime_video_call?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=zoomchat_session
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-new-app-password
SMTP_FROM=Realtime Video Calling <your-sender@gmail.com>
